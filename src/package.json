{
  "name": "src",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,socket -c blue,magenta \"pnpm dev\" \"pnpm socket:dev\"",
    "build": "next build",
    "start": "next start",
    "socket:basic": "tsx --env-file=.env lib/socket-basic.ts",
    "socket:dev": "tsx watch --env-file=.env lib/socket-basic.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reconcile": "tsx --env-file=.env scripts/reconcile-counts.ts",
    "postinstall": "prisma generate",
    "lint": "eslint"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.26",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/cluster-adapter": "^0.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "better-auth": "^1.7.26",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.5.1"
}
